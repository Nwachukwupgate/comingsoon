# Copy to .env for local use. On Vercel or Netlify, set these in the project's
# environment variable settings. Never commit real keys.

# Required for the enquiry forms and the coming soon signup.
RESEND_API_KEY=

# Where enquiries are sent. Default: info@upsworth-pms.com
ENQUIRY_TO=

# Sender. Must use a domain verified at https://resend.com/domains
# Example: Upsworth PMS <hello@upsworth-pms.com>
ENQUIRY_FROM=
